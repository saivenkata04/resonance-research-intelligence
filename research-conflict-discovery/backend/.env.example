ENVIRONMENT=development
PROJECT_NAME="RESONANCE — Research Intelligence"
API_V1_STR=/api/v1
SECRET_KEY=resonance_dev_secret_key_change_in_production_min_32_chars!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for effortless local development, PostgreSQL in production/docker)
DATABASE_URL=sqlite:///./resonance.db
# DATABASE_URL=postgresql+psycopg2://resonance:resonance@localhost:5432/resonance_db

# Async Celery & Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Ingestion & Storage Limits
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=35
MAX_PDF_PAGES=150

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
